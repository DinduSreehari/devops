# To enable  specific nodejs file
dnf module enable nodejs:20 -y

# To install node:20 version 
dnf install nodejs -y

#Create user and set password
useradd expense

password expense 
#expense

#Create app folder
mkdir /app

Download the packages

curl -o /app/backend.zip https://expense-builds.s3.us-east-1.amazonaws.com/expense-backend-v2.zip

cd /app
#unzip the folder
unzip /app/backend.zip

npm install


#We need to setup a new service in system

vim /etc/systemd/system/backend.service

[Unit]
Description = Backend Service

[Service]
User=expense
Environment=DB_HOST="localhost"
ExecStart=/bin/node /app/index.js
SyslogIdentifier=backend

[Install]
WantedBy=multi-user.target


nohup node index.js > /app/node.log 2>&1 &

systemctl daemon-reload
systemctl daemon-reload
systemctl enable backend





